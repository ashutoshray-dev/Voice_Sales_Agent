# AI Voice Sales Bot - Environment Configuration
# Copy this to .env and fill in your values

# Environment: dev or prod
ENV=dev

# --- Supabase (for call storage) ---
# Get from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- LLM Provider ---
# Choose one: groq (default), gemini, or ollama
LLM_PROVIDER=groq

# Groq API Key (required for groq)
# Get from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Google API Key (required for gemini)
# Get from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key

# --- LangSmith Tracing (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=voice-sales-agent