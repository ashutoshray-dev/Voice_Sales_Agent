# =============================================================================
# AI Voice Sales Bot — Environment Variables
# Copy this file to .env and fill in your values. .env is gitignored.
# =============================================================================

# --- App ---------------------------------------------------------------------
ENV=dev

# --- Supabase (free tier at supabase.com) ------------------------------------
# Create a project, go to Settings > API, copy URL and anon (public) key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- LLM Provider ------------------------------------------------------------
# Options: groq (default), gemini, ollama
LLM_PROVIDER=groq

# Groq (free tier at console.groq.com) — primary provider
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (free tier at makersuite.google.com) — fallback provider
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Ollama for offline dev only (not used on Render)
# OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: LangSmith tracing ---------------------------------------------
# Get keys at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=voice-sales-bot

# --- Render sets these automatically; don't set locally ----------------------
# PORT=8000
# RENDER=true